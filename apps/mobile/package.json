    "jest-expo": "57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "dev": "bash ../../scripts/dev-mobile",
    "check": "npm run typecheck && npm run lint && npm test -- --ci",
    "build:development": "npx --yes eas-cli@20.5.1 build --platform android --profile development",
    "build:preview": "npx --yes eas-cli@20.5.1 build --platform android --profile preview"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "private": true
